# cp .env.example apps/server/.env

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime — transaction pooler :6543, user postgres.YOUR_PROJECT_REF
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Prisma CLI — session pooler :5432 (same user); or db.YOUR_PROJECT_REF.supabase.co:5432 if direct works
DIRECT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=3001
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
