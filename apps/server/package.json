{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prisma-direct.ts migrate dev",
    "db:migrate:deploy": "tsx scripts/prisma-direct.ts migrate deploy",
    "db:status": "tsx scripts/prisma-direct.ts migrate status",
    "db:push": "tsx scripts/prisma-direct.ts db push",
    "db:studio": "tsx scripts/prisma-direct.ts studio"
  },
  "dependencies": {
    "@chess/engine": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.106.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
