{"nodes": [{"id": "docs_visual_charter", "label": "Regna Visual Charter", "file_type": "document", "source_file": "docs/visual-charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_pixel_scale_x4", "label": "Pixel \u00d74 Scale Rule", "file_type": "rationale", "source_file": "docs/visual-charter.md", "source_location": "\u00c9chelle & assets section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source assets are 16\u00d716 (tiles) or 16\u00d732 (pieces), displayed at \u00d74 = 64px cell. Integer scaling only (\u00d74, \u00d78). Never fractional (\u00d71.5, \u00d72.5). Nearest-neighbor filtering always \u2014 never bilinear/linear on game textures. image-rendering: pixelated for CSS sprites."}, {"id": "concept_visual_design_8bit", "label": "8-bit Pixel Art Visual Direction", "file_type": "rationale", "source_file": "docs/visual-charter.md", "source_location": "Piliers section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direction: retro 8-bit readable with modern fluidity (references: Noita, Dead Cells). Four pillars: Pixel First (limited palette, no blurry vectors), Living Motion (easing/particles/shake), Game Readability (<1s to read a move/card/evolution), Consistency (same visual language board+UI)."}, {"id": "concept_motion_system", "label": "Motion & Animation System", "file_type": "concept", "source_file": "docs/visual-charter.md", "source_location": "Motion section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Piece moves: lerp ease-out ~150-250ms, optional arc on captures. Cards/powers: flash + short particles, never block screen >400ms without skip. Camera: short rare shake on major events (\u22648px amplitude, \u2264200ms). Idle: optional micro-movement (1-2px, slow cycle) \u2014 never distract from moves."}, {"id": "concept_m6x11_font", "label": "m6x11 Bitmap Font", "file_type": "concept", "source_file": "docs/visual-charter.md", "source_location": "UI section", "source_url": null, "captured_at": null, "author": "Daniel Linssen", "contributor": null, "rationale": "Primary font for game screens. Sizes 16/32/48px only. Attribution required. Optional m6x11plus for extended characters. Local file: apps/client/public/fonts/m6x11.ttf."}], "edges": [{"source": "docs_visual_charter", "target": "concept_pixel_scale_x4", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual-charter.md", "source_location": "\u00c9chelle & assets section", "weight": 1.0}, {"source": "docs_visual_charter", "target": "concept_visual_design_8bit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual-charter.md", "source_location": "Piliers section", "weight": 1.0}, {"source": "docs_visual_charter", "target": "concept_m6x11_font", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual-charter.md", "source_location": "UI section", "weight": 1.0}, {"source": "docs_visual_charter", "target": "concept_motion_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual-charter.md", "source_location": "Motion section", "weight": 1.0}, {"source": "docs_visual_charter", "target": "sprites_chess_pieces_readme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/visual-charter.md", "source_location": "Cr\u00e9dits assets section", "weight": 1.0}, {"source": "concept_visual_design_8bit", "target": "concept_pixel_scale_x4", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/visual-charter.md", "source_location": null, "weight": 0.9}, {"source": "concept_visual_design_8bit", "target": "concept_motion_system", "relation": "conceptually_rel