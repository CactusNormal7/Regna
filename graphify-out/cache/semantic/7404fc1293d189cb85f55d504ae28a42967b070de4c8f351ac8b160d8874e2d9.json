{"nodes": [{"id": "src_product_plan", "label": "Regna Product Plan", "file_type": "document", "source_file": "src/PRODUCT-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_chess_engine_package", "label": "@chess/engine Package", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure TS + Zod, no UI or server imports. Source of truth for all chess rules and card validators. Shared by both client and server. Provides applyAction() as public API, used server-side in production (not client-side in ranked matches)."}, {"id": "concept_authoritative_server", "label": "Authoritative Server Rule", "file_type": "rationale", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 2 architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In ranked matches, the server applies all actions via @chess/engine. The client only applies actions locally in solo sandbox. This prevents cheating in competitive play."}, {"id": "concept_db_schema", "label": "Database Schema (Prisma/Postgres)", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UUID PKs, timestamptz, snake_case columns via @@map. Key tables: users, sessions, player_profiles, player_progression, player_stats, ratings, cards, passives, game_modes, achievements, decks, loadouts, rule_presets, matches, match_players, match_snapshots, match_moves, private_rooms, matchmaking_queue."}, {"id": "concept_socketio_contracts", "label": "Socket.IO Real-time Contracts", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client\u2192Server events: match:join, match:action, match:resign, match:ping. Server\u2192Client events: match:state, match:error, match:ended, match:opponent_left, match:clock. Shared protocol exported from packages/shared with Zod schemas + protocolVersion."}, {"id": "concept_turn_state_machine", "label": "Turn State Machine (GDD \u00a714)", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 1.3 and 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "States: TurnStart (refresh PA, draw 1, start effects) \u2192 ActionPhase (play card/move piece/piece ability) \u2192 TurnEnd (resolve end effects, expire temporaries) \u2192 game over or loop. Implemented in packages/engine/src/regna/turn.ts."}, {"id": "concept_nuxt_client_routes", "label": "Nuxt Client Routes", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes: / (landing), /login (guest), /register (guest), /lobby (auth), /deck (auth), /loadout (auth), /play/[matchId] (auth, Pixi), /sandbox (auth), /profile (auth), /stats (auth), /history (auth), /leaderboard (public), /preset/[id] (public)."}, {"id": "concept_product_roadmap", "label": "Product Roadmap Phases A-K", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phases: A (foundations), B (DB), C (auth), D (profile/stats), E (engine), F (client), G (REST API), H (realtime), I (matchmaking/ELO), J (full product loop), K (production). Milestones M0-M6. E+B parallelizable after A. Phase I blocked until C+B6+E4."}, {"id": "concept_elo_matchmaking", "label": "ELO Matchmaking System", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Sections 5.7, 11 Phase I", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ratings table per mode, default 1200. Private rooms (6-char code), ranked queue (rating-based matching). Future scale: migrate queue to Redis while keeping same service interface. ELO updates post-match."}, {"id": "concept_packages_shared", "label": "packages/shared (Zod DTOs & Socket Events)", "file_type": "concept", "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 2, 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exports Zod schemas, DTO types, Socket.IO event types, and protocolVersion. Shared between client and server via workspace:* dependency. Imports are compile-time type only (dotted lines in architecture diagram)."}], "edges": [{"source": "src_product_plan", "target": "concept_chess_engine_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 9", "weight": 1.0}, {"source": "src_product_plan", "target": "concept_authoritative_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 2", "weight": 1.0}, {"source": "src_product_plan", "target": "concept_db_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 5", "weight": 1.0}, {"source": "src_product_plan", "target": "concept_socketio_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/PRODUCT-PLAN.md", "source_location": "Section 8", "weight": 1.0}, {"source": "src_product_plan", "target": "concept_turn_state_machine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/PRODUCT-PLAN.md", "source_location": "Sections 1.3 and 9", "weight": 1.0}, {"source": "src_pro