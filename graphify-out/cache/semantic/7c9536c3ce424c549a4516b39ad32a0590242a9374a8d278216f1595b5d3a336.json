{"nodes": [{"id": "docs_technical_log", "label": "Regna Technical Log", "file_type": "document", "source_file": "docs/TECHNICAL-LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_prisma_supabase_integration", "label": "Prisma + Supabase Integration Pattern", "file_type": "rationale", "source_file": "docs/TECHNICAL-LOG.md", "source_location": "2026-05-22 entry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drizzle replaced by Prisma 7 + Supabase hosted Postgres. One ORM only. Prisma CLI uses DIRECT_DATABASE_URL (session pooler :5432) because the transaction pooler :6543 causes prepared-statement errors with Prisma CLI. Runtime app uses DATABASE_URL (transaction pooler :6543). Shell exports are overridden by .env loaded with override:true to avoid stale credential conflicts."}, {"id": "concept_load_env_override", "label": "load-env.ts Override Pattern", "file_type": "rationale", "source_file": "docs/TECHNICAL-LOG.md", "source_location": "2026-05-22 Server env loading entry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/server/src/load-env.ts uses override:true so .env file always wins over shell exports. Prevents P1000/P1001 errors caused by stale exported DATABASE_URL/DIRECT_DATABASE_URL pointing to wrong host/password after Supabase password reset."}, {"id": "concept_pixi_visual_scaffold", "label": "PixiJS Visual Scaffold", "file_type": "concept", "source_file": "docs/TECHNICAL-LOG.md", "source_location": "2026-05-24 entry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lib/visual, lib/pixi (nearest textures, layers, tween, camera shake, grid helpers), pixel-theme.css, /sprites nitro alias, home page preview. Validates full-pixel UI with m6x11 before board implementation."}], "edges": [{"source": "docs_technical_log", "target": "docs_regna_setup",