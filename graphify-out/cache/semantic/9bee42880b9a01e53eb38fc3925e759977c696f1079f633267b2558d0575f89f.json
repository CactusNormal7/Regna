{"nodes": [{"id": "archive_perplexity_gdd_chat", "label": "Perplexity GDD & Stack Chat (Chess Evolved)", "file_type": "document", "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_pa_action_points", "label": "PA (Points d'Action) System", "file_type": "concept", "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 6.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn-based action point system inspired by Dofus. PA visible to opponent, predictable, scarce. No automatic PA ramp-up \u2014 generation is slow, conditional, and tightly controlled. PA can be consumed by cards or piece actions."}, {"id": "concept_card_system", "label": "Card System (Deck + Draw + Timing)", "file_type": "concept", "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deck 10-15 cards. Draw 1 per turn. Empty deck reshuffles discard. Cards playable before/after piece moves. 5 reference cards from GDD \u00a715 implement first: fracture_ligne, surcharge_tactique, sacrifice_calcule, champ_instable, decret_urgence."}, {"id": "concept_buildcraft", "label": "Buildcraft System", "file_type": "concept", "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-game deck selection and passives/loadout construction. Players pick powers, passives, and optionally custom rules before each match. DB tables: decks, loadouts, rule_presets."}, {"id": "concept_pwa_mobile", "label": "PWA Mobile-First Strategy", "file_type": "rationale", "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "PWA section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single web responsive client covers PC, tablet, mobile via browser. PWA adds install capability (icon, fullscreen, cache) for near-native experience. Chose over Unity to avoid heavy WebGL, stay in TypeScript ecosystem. Uses @vite-pwa/nuxt (not abandoned @nuxtjs/pwa)."}, {"id": "concept_chess_evolved_gdd", "label": "Chess Evolved Game Design Document", "file_type": "concept", "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Full document", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three pillars: Buildcraft (pre-game army construction), Deep Strategy (synergies at high level), Controlled Surprise. Transformation level 6.5/10 \u2014 chess recognizable but all rules alterable. No inviolable rules. Target audience: players with chess basics + systemic game appreciation."}], "edges": [{"source": "archive_perplexity_gdd_chat", "target": "concept_chess_evolved_gdd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Full document", "weight": 1.0}, {"source": "archive_perplexity_gdd_chat", "target": "concept_pa_action_points", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 6.4", "weight": 1.0}, {"source": "archive_perplexity_gdd_chat", "target": "concept_card_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 6", "weight": 1.0}, {"source": "archive_perplexity_gdd_chat", "target": "concept_buildcraft", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 5", "weight": 1.0}, {"source": "archive_perplexity_gdd_chat", "target": "concept_pwa_mobile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "PWA section (second conversation)", "weight": 1.0}, {"source": "concept_card_system", "target": "concept_pa_action_points", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 6", "weight": 1.0}, {"source": "concept_buildcraft", "target": "concept_card_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Sections 5 and 6", "weight": 1.0}, {"source": "concept_chess_evolved_gdd", "target": "concept_turn_state_machine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 14", "weight": 1.0}, {"source": "concept_chess_evolved_gdd", "target": "concept_card_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/_archive/perplexity-gdd-and-stack-chat.md", "source_location": "Section 6", "weight": 1.0}], "hyperedges": []}